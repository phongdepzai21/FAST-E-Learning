rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.toLowerCase() == email.toLowerCase();
    }

    function incoming() {
      return request.resource.data;
    }

    // Master rule: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Courses Collection: Public read, authenticated write (simplified for MVP)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Notes Collection
    match /notes/{noteId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Users Collection (User Profiles & Course Progress)
    match /users/{userEmail} {
      // Allow users to read and write their own profile
      allow read: if isOwner(userEmail);
      allow create, update: if isOwner(userEmail) && isValidUserProfile(incoming());
      allow delete: if isOwner(userEmail);

      // Subcollection: Purchased Courses (Progress Tracking)
      match /purchased_courses/{courseId} {
        allow read: if isOwner(userEmail);
        allow create, update: if isOwner(userEmail) && isValidCourseProgress(incoming());
        allow delete: if isOwner(userEmail);
      }

      // Subcollection: Gamification Stats
      match /gamification/{statId} {
        allow read: if isOwner(userEmail);
        allow create, update: if isOwner(userEmail) && isValidGamification(incoming());
        allow delete: if isOwner(userEmail);
      }
    }

    // Validation Schemas
    function isValidUserProfile(data) {
      return (
        (!('email' in data) || data.email is string) &&
        (!('displayName' in data) || data.displayName is string) &&
        (!('avatar' in data) || data.avatar is string) &&
        (!('isVip' in data) || data.isVip is bool) &&
        (!('isAdmin' in data) || data.isAdmin is bool) &&
        (!('isTeacher' in data) || data.isTeacher is bool) &&
        (!('rolePromotedByAdmin' in data) || data.rolePromotedByAdmin is bool) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp)
      );
    }

    function isValidCourseProgress(data) {
      return (
        (!('purchasedAt' in data) || data.purchasedAt is string || data.purchasedAt is timestamp) &&
        (!('completedLessons' in data) || data.completedLessons is list) &&
        (!('lastAccessedAt' in data) || data.lastAccessedAt is string || data.lastAccessedAt is timestamp) &&
        (!('notes' in data) || data.notes is map) &&
        (!('lastNotesUpdatedAt' in data) || data.lastNotesUpdatedAt is string || data.lastNotesUpdatedAt is timestamp) &&
        (!('courseTitle' in data) || data.courseTitle is string) &&
        (!('progressPercentage' in data) || data.progressPercentage is number) &&
        (!('progress' in data) || data.progress is number) &&
        (!('lastLessonIdx' in data) || data.lastLessonIdx is number) &&
        (!('lastLessonTitle' in data) || data.lastLessonTitle is string)
      );
    }

    function isValidGamification(data) {
      return (
        (!('points' in data) || data.points is number) &&
        (!('level' in data) || data.level is number) &&
        (!('streakDays' in data) || data.streakDays is number) &&
        (!('lastActiveDate' in data) || data.lastActiveDate is string) &&
        (!('totalLessonsCompleted' in data) || data.totalLessonsCompleted is number) &&
        (!('completedCoursesCount' in data) || data.completedCoursesCount is number) &&
        (!('totalNotesCreated' in data) || data.totalNotesCreated is number) &&
        (!('unlockedBadgeIds' in data) || data.unlockedBadgeIds is list) &&
        (!('unlockedBadgeDates' in data) || data.unlockedBadgeDates is map)
      );
    }
  }
}


