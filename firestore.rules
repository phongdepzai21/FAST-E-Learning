rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Courses Collection (Master database of courses)
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // 2. Users Collection (User profiles and roles)
    match /users/{userEmail} {
      allow read, write: if true;

      // Subcollection: Purchased Courses tracked per user
      match /purchased_courses/{courseId} {
        allow read, write: if true;
      }
    }

    // 3. Fallback default rule for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

