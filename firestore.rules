rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             (
               request.auth.token.email.matches('(?i)^h1h4phong@gmail.com$') ||
               request.auth.token.email.matches('(?i)^hkc.qms@gmail.com$') ||
               request.auth.token.email.matches('(?i)^trdung153@gmail.com$') ||
               request.auth.token.email.matches('(?i)^lediem.ngo@gmail.com$')
             );
    }
    
    function isOwner(email) {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.matches('(?i)^' + email + '$');
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Courses Collection (Public read, Admin write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Subcollections of courses
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Users Collection (Users can read/write their own profiles, Admins can read/write all)
    match /users/{userEmail} {
      allow read, write: if isOwner(userEmail) || isAdmin();
      
      // Subcollections of users (e.g., purchased_courses)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userEmail) || isAdmin();
      }
    }
  }
}
