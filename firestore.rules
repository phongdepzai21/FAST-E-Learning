rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function getUserEmail() {
      return (request.auth != null && request.auth.token != null && request.auth.token.email != null) 
        ? request.auth.token.email.lower() 
        : '';
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }
    
    function isOwner(email) { 
      return isSignedIn() && (
        (getUserEmail() != '' && getUserEmail() == email.lower()) ||
        (request.auth.uid == email)
      ); 
    }

    function isSystemOwner() {
      return isSignedIn() && (
        getUserEmail() == 'h1h4phong@gmail.com' ||
        getUserEmail() == 'trdung153@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSystemOwner() ||
        getUserEmail() == 'h1h4phong@gmail.com' ||
        getUserEmail() == 'hkc.qms@gmail.com' ||
        getUserEmail() == 'trdung153@gmail.com' ||
        getUserEmail() == 'lediem.ngo@gmail.com' ||
        (
          getUserEmail() != '' &&
          exists(/databases/$(database)/documents/users/$(getUserEmail())) && 
          get(/databases/$(database)/documents/users/$(getUserEmail())).data.get('isAdmin', false) == true
        )
      );
    }
    
    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        getUserEmail() == 'h1h4phong@gmail.com' ||
        getUserEmail() == 'hkc.qms@gmail.com' ||
        getUserEmail() == 'trdung153@gmail.com' ||
        getUserEmail() == 'lediem.ngo@gmail.com' ||
        (
          getUserEmail() != '' &&
          exists(/databases/$(database)/documents/users/$(getUserEmail())) && (
            get(/databases/$(database)/documents/users/$(getUserEmail())).data.get('isTeacher', false) == true ||
            get(/databases/$(database)/documents/users/$(getUserEmail())).data.get('isAdmin', false) == true ||
            get(/databases/$(database)/documents/users/$(getUserEmail())).data.get('role', '') in ['teacher', 'giangvien', 'admin', 'Owner', 'Admin']
          )
        )
      );
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2048)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
             (!('isVip' in data) || data.isVip is bool) &&
             (!('isAdmin' in data) || data.isAdmin is bool) &&
             (!('isTeacher' in data) || data.isTeacher is bool) &&
             (!('isOwner' in data) || data.isOwner is bool) &&
             (!('isLocked' in data) || data.isLocked is bool) &&
             (!('lockedAt' in data) || data.lockedAt == null || (data.lockedAt is string && data.lockedAt.size() <= 64)) &&
             (!('lockReason' in data) || data.lockReason == null || (data.lockReason is string && data.lockReason.size() <= 256)) &&
             (!('rolePromotedByAdmin' in data) || data.rolePromotedByAdmin is bool) &&
             (!('purchasedCoursesCount' in data) || data.purchasedCoursesCount is int) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 32));
    }

    function isValidPurchasedCourse(data) {
      return (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
             (!('courseTitle' in data) || (data.courseTitle is string && data.courseTitle.size() <= 256)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
             (!('price' in data) || (data.price is string && data.price.size() <= 64)) &&
             (!('purchasedAt' in data) || (data.purchasedAt is string && data.purchasedAt.size() <= 64)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('progress' in data) || (data.progress is int || data.progress is float)) &&
             (!('completedLessons' in data) || (data.completedLessons is list && data.completedLessons.size() <= 1000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 100000) || (data.notes is list && data.notes.size() <= 1000)) &&
             (!('lastNotesUpdatedAt' in data) || (data.lastNotesUpdatedAt is string && data.lastNotesUpdatedAt.size() <= 64)) &&
             (!('videoTimestamps' in data) || data.videoTimestamps is map);
    }

    function isValidGamificationStats(data) {
      return (!('points' in data) || data.points is int) &&
             (!('level' in data) || data.level is int) &&
             (!('streakDays' in data) || data.streakDays is int) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 64)) &&
             (!('completedLessonsCount' in data) || data.completedLessonsCount is int) &&
             (!('certificatesEarned' in data) || data.certificatesEarned is int) &&
             (!('unlockedBadgeIds' in data) || (data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 100)) &&
             (!('unlockedBadgeDates' in data) || data.unlockedBadgeDates is map);
    }

    function isValidCourse(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
             (!('price' in data) || (data.price is string && data.price.size() <= 64)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1024)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 128)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('curriculum' in data) || data.curriculum is list);
    }

    function isValidCombo(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 256)) &&
             (!('price' in data) || (data.price is string && data.price.size() <= 64)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1024)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('courseIds' in data) || data.courseIds is list) &&
             (!('benefits' in data) || data.benefits is list);
    }

    // --- Collection Rules ---

    // 1. Users
    match /users/{userEmail} {
      allow get: if isOwner(userEmail) || isAdmin() || isTeacher();
      allow list: if isAdmin() || isTeacher();
      
      // On create: Owner can create their own profile, or Admin can provision/approve profile
      allow create: if (isOwner(userEmail) || isAdmin()) && isValidId(userEmail) && isValidUser(incoming()) && (
        isAdmin() || 
        (incoming().get('isAdmin', false) == false && incoming().get('isTeacher', false) == false && incoming().get('isVip', false) == false)
      );

      allow update: if (isOwner(userEmail) || isAdmin()) && isValidId(userEmail) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          incoming().get('isAdmin', false) == existing().get('isAdmin', false) &&
          incoming().get('isTeacher', false) == existing().get('isTeacher', false) &&
          incoming().get('isVip', false) == existing().get('isVip', false)
        )
      );

      allow delete: if isAdmin();
      
      // 1.1 Purchased Courses Subcollection
      match /purchased_courses/{courseId} {
        allow read: if isOwner(userEmail) || isAdmin() || isTeacher();
        allow create, update: if (isOwner(userEmail) || isAdmin()) && isValidId(courseId) && isValidPurchasedCourse(incoming());
        allow delete: if isAdmin();
      }

      // 1.2 Gamification Stats
      match /gamification/{docId} {
        allow read: if isOwner(userEmail) || isAdmin() || isTeacher();
        allow create, update: if (isOwner(userEmail) || isAdmin()) && isValidGamificationStats(incoming());
        allow delete: if isAdmin();
      }

      // 1.3 Notifications Subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userEmail) || isAdmin();
        allow write: if isAdmin() || isSystemOwner();
      }
    }

    // 2. Courses (Global)
    match /courses/{courseId} {
      allow read: if true; // Publicly readable for catalog listing
      allow create, update: if (isAdmin() || isTeacher()) && isValidId(courseId) && isValidCourse(incoming());
      allow delete: if isAdmin() || isTeacher();
    }

    // 3. Combos (Global)
    match /combos/{comboId} {
      allow read: if true; // Publicly readable for catalog listing
      allow create, update: if (isAdmin() || isTeacher()) && isValidId(comboId) && isValidCombo(incoming());
      allow delete: if isAdmin() || isTeacher();
    }

    // 4. Fast Standards Audits (FSA-Checklist)
    match /fast_standards_audits/{auditId} {
      allow read, write: if isSystemOwner() || isAdmin();
    }

    // 5. Ad Profile CRM Records (Ads)
    match /ad_profile_crm/{recordId} {
      allow read, write: if isSystemOwner() || isAdmin();
    }

    // 6. Food Safety CRM Records (ATTP)
    match /fast_food_safety_crm/{recordId} {
      allow read, write: if isSystemOwner() || isAdmin();
    }

    // 7. Fast HACCP CRM Records (HACCP Checklist)
    match /fast_haccp_crm/{recordId} {
      allow read, write: if isSystemOwner() || isAdmin();
    }

    // 8. Fast ISO 22000 CRM Records (ISO 22K Checklist)
    match /fast_iso22k_crm/{recordId} {
      allow read, write: if isSystemOwner() || isAdmin();
    }

    // 9. Manual Unlocks Logs
    match /manual_unlocks/{unlockId} {
      allow read, write: if isAdmin() || isSystemOwner();
    }

    // 10. Course Registrations Logs and Notices
    match /course_registrations/{registrationId} {
      allow read: if isAdmin() || isSystemOwner() || isTeacher();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSystemOwner();
    }

    // 11. Payment Config (Banking / QR Code)
    match /payment_config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSystemOwner();
    }

    // 12. Sync Control (Global real-time cache invalidation)
    match /sync_control/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSystemOwner();
    }

    // 13. Global Sync (Real-time form reset synchronization across tabs)
    match /global_sync/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 14. Student Progress (Live progress autosave)
    match /student_progress/{userEmail} {
      allow read: if isOwner(userEmail) || isAdmin() || isTeacher();
      allow write: if isOwner(userEmail) || isAdmin();
    }

    // 15. Payment Logs (Webhook inspection and debugging)
    match /payment_logs/{logId} {
      allow read, write: if isAdmin() || isSystemOwner();
    }

    // 16. System Diagnostics (Firestore latency ping)
    match /system_diagnostics/{docId} {
      allow read, write: if isSignedIn();
    }

    // 17. Pending Payments (Pre-recorded bank transfer orders)
    match /pending_payments/{paymentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSystemOwner();
    }
  }
}
