{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing roles and creation metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Lowercase email address of the user" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "fullName": { "type": "string", "description": "Full name of the user" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "avatar": { "type": "string", "description": "Avatar icon or image data" },
        "phone": { "type": "string", "description": "Phone number" },
        "createdAt": { "type": "string", "description": "ISO 8601 creation timestamp string" },
        "isVip": { "type": "boolean", "description": "Flag indicating if user is a VIP subscriber" },
        "isAdmin": { "type": "boolean", "description": "Flag indicating if user is an Administrator" },
        "isTeacher": { "type": "boolean", "description": "Flag indicating if user is a Teacher" },
        "isLocked": { "type": "boolean", "description": "Flag indicating if the user account is locked/banned" },
        "lockedAt": { "type": "string", "description": "ISO 8601 timestamp when account was locked" },
        "lockReason": { "type": "string", "description": "Reason for locking the account" },
        "updatedAt": { "type": "string", "description": "ISO 8601 update timestamp string" }
      },
      "required": ["email"]
    },
    "PurchasedCourse": {
      "title": "PurchasedCourse",
      "description": "A record of registration or purchase of a course by a user",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "description": "ID of the registered course" },
        "courseTitle": { "type": "string", "description": "Name/Title of the course" },
        "purchasedAt": { "type": "string", "description": "ISO timestamp when registered" },
        "price": { "type": "string", "description": "Registration cost or price" },
        "status": { "type": "string", "description": "Status of the course registration" },
        "progress": { "type": "integer", "description": "Course completion progress (0-100)" },
        "updatedAt": { "type": "string", "description": "ISO update timestamp string" }
      },
      "required": ["courseId"]
    },
    "Course": {
      "title": "Course",
      "description": "Master data record for dynamic courses listed on the platform",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Course title" },
        "price": { "type": "string", "description": "Formatted tuition price" },
        "image": { "type": "string", "description": "Banner photo URL" },
        "category": { "type": "string", "description": "Subject category group" },
        "description": { "type": "string", "description": "Detailed description of the course content" }
      },
      "required": ["title"]
    },
    "Combo": {
      "title": "Combo",
      "description": "Master data record for dynamic combo packages offered on the platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Combo package unique ID" },
        "title": { "type": "string", "description": "Combo package title" },
        "price": { "type": "string", "description": "Formatted package price" },
        "originalPrice": { "type": "string", "description": "Original unDiscounted price" },
        "savings": { "type": "string", "description": "Savings summary tag" },
        "image": { "type": "string", "description": "Banner photo URL" },
        "description": { "type": "string", "description": "Detailed description of the combo" },
        "status": { "type": "string", "description": "Status (active or inactive)" },
        "courseIds": { "type": "array", "description": "Array of course IDs included in this combo" },
        "benefits": { "type": "array", "description": "Array of feature benefit bullet points" },
        "updatedAt": { "type": "string", "description": "ISO update timestamp string" }
      },
      "required": ["title"]
    },
    "ManualUnlock": {
      "title": "ManualUnlock",
      "description": "Log record of a course manually activated for a user by an administrator",
      "type": "object",
      "properties": {
        "studentEmail": { "type": "string", "description": "Lowercase email address of the student" },
        "courseId": { "type": "string", "description": "ID of the activated course" },
        "courseTitle": { "type": "string", "description": "Title of the activated course" },
        "unlockedBy": { "type": "string", "description": "Email address of the administrator who authorized the unlock" },
        "unlockedAt": { "type": "string", "description": "ISO timestamp when the course was unlocked" }
      },
      "required": ["studentEmail", "courseId", "unlockedBy"]
    },
    "CourseRegistration": {
      "title": "CourseRegistration",
      "description": "Log record of a student self-registering or purchase enrollment of a course",
      "type": "object",
      "properties": {
        "studentEmail": { "type": "string", "description": "Lowercase email address of the student" },
        "studentName": { "type": "string", "description": "Display name of the student" },
        "courseId": { "type": "string", "description": "ID of the registered course" },
        "courseTitle": { "type": "string", "description": "Title of the registered course" },
        "registeredAt": { "type": "string", "description": "ISO timestamp when enrollment occurred" },
        "price": { "type": "string", "description": "Price at registration time" },
        "status": { "type": "string", "description": "Active status" },
        "type": { "type": "string", "description": "Type of claim or purchase" }
      },
      "required": ["studentEmail", "courseId", "registeredAt"]
    },
    "PaymentConfig": {
      "title": "PaymentConfig",
      "description": "Global bank account and QR payment configuration",
      "type": "object",
      "properties": {
        "bankId": { "type": "string", "description": "Bank code" },
        "bankName": { "type": "string", "description": "Bank full name" },
        "accountNo": { "type": "string", "description": "Bank account number" },
        "accountName": { "type": "string", "description": "Beneficiary account name" }
      }
    },
    "SyncControl": {
      "title": "SyncControl",
      "description": "Meta-document for real-time global cache invalidation signals",
      "type": "object",
      "properties": {
        "lastUpdated": { "type": "integer", "description": "Millisecond timestamp of the last invalidation" }
      }
    },
    "GlobalSync": {
      "title": "GlobalSync",
      "description": "Signal document for cross-tab multi-session real-time form reset",
      "type": "object",
      "properties": {
        "timestamp": { "type": "integer", "description": "Millisecond timestamp of the reset signal" }
      }
    },
    "FastIso22kCrm": {
      "title": "FastIso22kCrm",
      "description": "ISO 22000 checklist state and records",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Student lesson autosave progress data",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "PaymentLog": {
      "title": "PaymentLog",
      "description": "Audit and diagnostic webhook records",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Account notification delivered to a user (including training class links and approvals)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification document ID" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification body text" },
        "type": { "type": "string", "description": "Notification type (training_link, approval, new, updated)" },
        "courseId": { "type": "string", "description": "Related course ID" },
        "courseTitle": { "type": "string", "description": "Related course title" },
        "registrationId": { "type": "string", "description": "Related registration ID" },
        "link": { "type": "string", "description": "Class meeting link or resource URL" },
        "userEmail": { "type": "string", "description": "Lowercase recipient email" },
        "isRead": { "type": "boolean", "description": "Read status flag" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" }
      },
      "required": ["title", "message", "type", "isRead"]
    },
    "TrainingCourse": {
      "title": "TrainingCourse",
      "description": "Live/Zoom training course definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "10-digit training course ID" },
        "title": { "type": "string", "description": "Training course title" },
        "price": { "type": "string", "description": "Formatted tuition price" },
        "category": { "type": "string", "description": "Training category" },
        "trainingFormat": { "type": "string", "description": "zoom, direct, both, or inhouse" },
        "meetingLink": { "type": "string", "description": "Zoom/Meet class link sent to registered accounts" },
        "status": { "type": "string", "description": "active or inactive" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "users/{userEmail}": {
      "schema": "User",
      "description": "User accounts mapped by their lowercased email addresses"
    },
    "users/{userEmail}/purchased_courses/{courseId}": {
      "schema": "PurchasedCourse",
      "description": "A subcollection tracking course enrollment details and progression per user"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Platform course documents editable by admins and teachers"
    },
    "combos/{comboId}": {
      "schema": "Combo",
      "description": "Platform combo packages editable by admins and teachers"
    },
    "customCombos/{comboId}": {
      "schema": "Combo",
      "description": "Custom combo packages created and synchronized across the platform"
    },
    "manual_unlocks/{unlockId}": {
      "schema": "ManualUnlock",
      "description": "Log records tracking administrative course activations"
    },
    "course_registrations/{registrationId}": {
      "schema": "CourseRegistration",
      "description": "Public/Admin feed tracking course enrollments on the platform"
    },
    "direct_course_registrations/{regId}": {
      "schema": "DirectCourseRegistration",
      "description": "Direct and Zoom live course training enrollments (199k)"
    },
    "payment_config/{configId}": {
      "schema": "PaymentConfig",
      "description": "Global bank account and QR payment configuration"
    },
    "sync_control/{docId}": {
      "schema": "SyncControl",
      "description": "Global sync invalidation signals"
    },
    "global_sync/{docId}": {
      "schema": "GlobalSync",
      "description": "Real-time form reset synchronization across tabs"
    },
    "fast_iso22k_crm/{recordId}": {
      "schema": "FastIso22kCrm",
      "description": "ISO 22000 audit records and session"
    },
    "student_progress/{userEmail}": {
      "schema": "StudentProgress",
      "description": "Live student lesson progress autosave"
    },
    "payment_logs/{logId}": {
      "schema": "PaymentLog",
      "description": "Payment webhook inspection logs"
    },
    "featured_courses/{docId}": {
      "schema": "FeaturedCoursesConfig",
      "description": "Configuration containing the top 5 featured course IDs"
    },
    "live_course_registrations/{regId}": {
      "schema": "LiveCourseRegistration",
      "description": "Live food safety training (199k) student registration records"
    },
    "users/{userEmail}/notifications/{notifId}": {
      "schema": "UserNotification",
      "description": "Per-user account notifications including training class links"
    },
    "training_courses/{courseId}": {
      "schema": "TrainingCourse",
      "description": "Live and Zoom training courses catalog"
    }
  }
}
